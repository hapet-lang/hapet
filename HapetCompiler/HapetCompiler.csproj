<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableNETAnalyzers>false</EnableNETAnalyzers>
        <AnalysisMode>AllEnabledByDefault</AnalysisMode>
        <Version>0.0.1</Version>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
        <AssemblyName>hapet</AssemblyName>
        <ApplicationIcon>logo.ico</ApplicationIcon>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\HapetFrontend\HapetFrontend.csproj" />
        <ProjectReference Include="..\HapetPostPrepare\HapetPostPrepare.csproj" />
        <ProjectReference Include="..\HapetLastPrepare\HapetLastPrepare.csproj" />
        <ProjectReference Include="..\HapetBackend\HapetBackend.csproj" />
        <ProjectReference Include="..\HapetLsp\HapetLsp.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="HashComputer" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="../build-resources/version.txt">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="logo.ico" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="ProjectTemplateData/**">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
